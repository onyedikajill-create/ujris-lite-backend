# UJRIS Lite v3.0.0 - Environment Configuration

# Application
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://ujris:ujris_secret@localhost:5432/ujris_lite

# Redis (optional - falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_secure_random_string_min_64_chars
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=change_this_to_a_secure_admin_key

# AI
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-4-5
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_MAX_RETRIES=3
AI_RETRY_DELAY_MS=1000

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AI_MAX=20

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain

# Refund
REFUND_ELIGIBLE_AFTER_HOURS=24
REFUND_BASE_AMOUNT=99.00
REFUND_CURRENCY=GBP
